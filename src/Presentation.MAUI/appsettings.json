{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Temp\\Storage\\logs\\warnings-errors-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DbConnection": "Server=.\\SQLEXPRESS;Database=TravelPlanner;Trusted_Connection=True;Encrypt=False"
  },
  "Storage": {
    "BasePath": "C:\\Temp\\Storage"
  },
  "OutputFileName": {
    "PDF_Travel": "Travel-{0}.pdf",
    "ZIP_Memories": "Memories-{0}.zip",
    "TRAVEL_EXPORT": "Export-{0}.tbin"
  },
  "GoogleURL": "https://www.google.com/maps/search/"

}
