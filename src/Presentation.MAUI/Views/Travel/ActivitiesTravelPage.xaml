<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Presentation.MAUI.ViewModel"
             xmlns:entities="clr-namespace:BussinessLogic.Entities;assembly=BussinessLogic"
             x:Class="Presentation.MAUI.Views.Travel.ActivitiesTravelPage"
             x:DataType="vm:ActivitiesTravelVM"
             xmlns:conv="clr-namespace:Presentation.MAUI.Converters"
             Title="Activités du voyage">
    <!-- Converters -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:CurrencyInputConverter x:Key="CurrencyInputConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="60,*" Margin="0"  BackgroundColor="#FFD580">
        <VerticalStackLayout Grid.Row="0" Background="LightGrey" >
            <FlexLayout JustifyContent="SpaceAround"  AlignContent="SpaceBetween" AlignItems="Start"  Margin="5">
                <Button 
                     Text="Nouvelle Activité" 
                     ImageSource="{StaticResource CloneIcon}"
                     Command="{Binding AddActivityCommand}"
                     BackgroundColor="White"
                     TextColor="Black"
                     FontAttributes="Bold"
                     CornerRadius="8"
                     HeightRequest="48"
                     WidthRequest="200"
                     HorizontalOptions="Start" />
                <Button Text="Sauvegarder"
                    ImageSource="{StaticResource SaveIcon}"
                    IsVisible="{Binding SaveButtonVisible}"
                    FontSize="14"
                    FontAttributes="Bold"
                    HeightRequest="48"                    
                    CornerRadius="8"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    Command="{Binding SaveActivityCommand}"       
                    HorizontalOptions="Fill" />


            </FlexLayout>

        </VerticalStackLayout >

        <ScrollView Grid.Row="1">
            <FlexLayout            
            Direction="Row"
            Wrap="Wrap"
            JustifyContent="SpaceAround"
            AlignItems="Start"     
            Padding="10"
            
            BindableLayout.ItemsSource="{Binding Activities}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="entities:TravelActivity">
                        <Border
                        WidthRequest="250"
                        HeightRequest="250"
                        FlexLayout.Grow="0"
                        FlexLayout.Shrink="0"
                        Stroke="#D0D0D0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="1"
                        Margin="0">
                            <!-- Drag & Drop sur le Border -->
                            <Border.GestureRecognizers>
                                <DragGestureRecognizer DragStarting="OnDragStarting" />
                                <DropGestureRecognizer Drop="OnDrop" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout
                            Spacing="10"
                            Padding="20"                            
                            >
                                <!-- En-tête : icône, séquence et date -->
                                <FlexLayout
                                Direction="Row"
                                AlignItems="Center"
                                JustifyContent="SpaceBetween"                                >
                                    <Image Margin="5"
                                    Source="{StaticResource DestinationIcon}"
                                    WidthRequest="40"
                                    HeightRequest="40" />
                                    <Label
                                    Text="{Binding ActivityDate, StringFormat='{0:dd/MM/yyyy}'}"
                                    FontSize="12"
                                    TextColor="Gray"
                                    HorizontalOptions="EndAndExpand" />

                                </FlexLayout>

                                <!-- Titre de l'activité -->
                                <Label      Text="{Binding Name}"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />

                                <!-- Séparateur -->
                                <BoxView
                                HeightRequest="1"
                                BackgroundColor="LightGray"
                                HorizontalOptions="FillAndExpand"/>

                                <!-- Description tronquée -->
                                <Label
                                Text="{Binding Description}"
                                FontSize="14"
                                TextColor="#444"
                                LineBreakMode="TailTruncation"
                                MaxLines="3" />
                                <HorizontalStackLayout Spacing="10">
                                     <Label Text="{Binding PlannedCost, StringFormat='Est. {0:F2} €'}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="#1565C0" />
                                <Label Text="{Binding Total, StringFormat='/ Cost. {0:F2} €'}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="#1565C0" />
                                </HorizontalStackLayout>
                               
                                <!-- Séparateur -->
                                <BoxView
                                HeightRequest="1"
                                BackgroundColor="LightGray"
                                HorizontalOptions="FillAndExpand"/>

                                <!-- Pied de carte : coût estimé + lien Google -->
                                <FlexLayout Margin="10"
                                Direction="Row"
                                AlignItems="Center"
                                JustifyContent="Start">
                                    <Button
                                    ImageSource="{StaticResource InvoiceIcon}"            
                                    BackgroundColor="Transparent"
                                    WidthRequest="24"
                                    HeightRequest="24"                                  
                                    Command="{Binding BindingContext.CostLinkClickedCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding ActivityID}" />
                                    <Button ImageSource="{StaticResource RemoveIcon}" 
                                        BackgroundColor="Transparent"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        Command="{Binding BindingContext.DeleteActivityCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}"/>
                                    <Button ImageSource="{StaticResource EditIcon}"
                                        BackgroundColor="Transparent"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        Command="{Binding BindingContext.EditActivityCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />
                                    <Button ImageSource="{StaticResource WwwIcon}" 
                                        BackgroundColor="Transparent"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        Command="{Binding BindingContext.OpenGoogleLinkCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding GoogleLink}" />
                                    <Button ImageSource="{StaticResource NoteIcon}" 
                                            BackgroundColor="Transparent"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            Command="{Binding BindingContext.OpenGoogleLinkCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding GoogleLink}" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>
    </Grid>

