<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Presentation.MAUI.Views.Activity.NewCostActivityPage"
             xmlns:views="clr-namespace:Presentation.MAUI.Views"
             xmlns:vm="clr-namespace:Presentation.MAUI.ViewModel.Activity"
             xmlns:entities="clr-namespace:BussinessLogic.Entities;assembly=BussinessLogic"
          xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:DataType="vm:NewCostActivityVM"
             Title="NewCostActivityPage">

    <ScrollView>
          <Grid RowDefinitions="Auto,Auto,Auto" BackgroundColor="#FFD580" Padding="20" RowSpacing="15">
        <views:NavigationLayout Grid.Row="0"></views:NavigationLayout>
         <!--Zone 1: formulaire d'ajout-->
        <Grid Grid.Row="1" Padding="10" ColumnSpacing="12" BackgroundColor="White">

            <Grid.ColumnDefinitions>
                <!-- Nom : 2 parts -->
                <ColumnDefinition Width="2*" />
                <!-- Prix : auto (ou mettez WidthRequest sur l'Entry) -->
                <ColumnDefinition Width="Auto" />
                <!-- Devise : auto -->
                <ColumnDefinition Width="Auto" />
                <!-- Bouton : auto -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Entry
                Grid.Column="0"
                Placeholder="Nom"
                Text="{Binding NewCostName,Mode=TwoWay}"
                 />

            <Entry    Grid.Column="1"
                      Placeholder="Prix"
                      WidthRequest="80"
                      Keyboard="Numeric"
                      Text="{Binding NewCostAmount,Mode=TwoWay}" />
            <Picker
                Grid.Column="2"
                Title="Devise"
                WidthRequest="80"
                ItemsSource="{Binding DataStore.Currencies}"
                SelectedItem="{Binding NewCurrency,Mode=TwoWay}" />

            <Button
                Grid.Column="3"
                Text="Ajouter"
                BackgroundColor="Red"
                WidthRequest="80"
                Command="{Binding AddCostCommand}" />

        </Grid>

        <!-- Zone 2: liste des coûts -->

        <Border    Grid.Row="3"
                   Margin="5"
                   Padding="10"
                   BackgroundColor="White" Stroke="#D0D0D0"
                   StrokeThickness="1"
                   StrokeShape="RoundRectangle 12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Total"
             FontAttributes="Bold"
             TextColor="Black" />
                <Label Grid.Column="1"
             Text="{Binding TravelActivity.Total, StringFormat='{}{0:C}'}"
             FontAttributes="Bold"
             VerticalOptions="Center" />
            </Grid>
        </Border>
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Costs}"
            SelectionMode="None" BackgroundColor="Transparent"
            EmptyView="Aucun coût défini">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:Cost">
                    <Border Margin="5"
                            Padding="10"
                            BackgroundColor="White"
                            Stroke="#D0D0D0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,*,*"  BackgroundColor="White">
                            <StackLayout Grid.Column="0" FlowDirection="LeftToRight">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Currency}" FontSize="12" />
                                <Label Text="{Binding TicketsList.Count, StringFormat='{}{0} ticket(s) enregistré'}" FontSize="12" />
                            </StackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                <Label
                                         Text="{Binding Price, StringFormat='{}{0:C}'}"
                                         VerticalOptions="Center"
                                         FontAttributes="Bold" />

                                <Button Text="Ajouter ticket"
                                        Command="{Binding BindingContext.AddTicketCommand,  Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding CostID}"
                                        Background="AliceBlue" TextColor="Black">
                                </Button>
                                <Button Text="Supprimer depense"
                                        Command="{Binding BindingContext.RemoveCostCommand,  Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding CostID}"
                                        Background="AliceBlue" TextColor="Black">
                                </Button>
                            </VerticalStackLayout>

                            <FlexLayout    Grid.Column="1"
                                           BindableLayout.ItemsSource="{Binding TicketsList}"
                                           Direction="Row"
                                           Wrap="Wrap"
                                           JustifyContent="Start"
                                           AlignItems="Center"
                                           Padding="0,4,0,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="sys:Guid">
                                        <Grid RowDefinitions="80,0" ColumnDefinitions="*,*">
                                            <Button Grid.Row="0"
                                                MaximumWidthRequest="80"
                                                MinimumWidthRequest="20"
                                                ImageSource="{StaticResource BillIcon}"
                                                BackgroundColor="Transparent"
                                                Command="{Binding BindingContext.OpenTicketCommand,
                                                Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" ></Button>
                                            <Button Grid.Row="1"
                                                    ImageSource="remove.png"  
                                                    WidthRequest="80"
                                                    BackgroundColor="Transparent"
                                                    HeightRequest="40"
                                                   
                                                    Command="{Binding BindingContext.RemoveTicketCommand,
                                                    Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                    CommandParameter="{Binding . }" />                                            
                                        </Grid>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
    </ScrollView>
  
</ContentPage>