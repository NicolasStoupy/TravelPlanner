<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Presentation.MAUI.Views.Activity.NewActivityPage"
             xmlns:vm="clr-namespace:Presentation.MAUI.ViewModel.Activity"
             xmlns:entities="clr-namespace:BussinessLogic.Entities;assembly=BussinessLogic"
             xmlns:views="clr-namespace:Presentation.MAUI.Views"
             xmlns:conv="clr-namespace:Presentation.MAUI.Converters"
             x:DataType="vm:NewActivityVM"
             Title="Nouvelle activité">
    <!-- Converters -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:IntToStringConverter  x:Key="IntToStringConverter"></conv:IntToStringConverter>
        </ResourceDictionary>
    </ContentPage.Resources>
    <!-- Converters -->
    <ScrollView>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <VerticalStackLayout Grid.Column="0" Padding="20" Spacing="15" >
                <views:NavigationLayout></views:NavigationLayout>
                <Label Text="Nom de l'activité" />
                <Entry Text="{Binding ActivityName}" Placeholder="Nom" />

                <Label Text="Description" />
                <Editor Text="{Binding CurrentTravelActivity.Description}" Placeholder="Description" AutoSize="TextChanges" />

                <Label Text="Ordre (séquence)" />
                <Label Text="{Binding CurrentTravelActivity.Sequence, Converter={StaticResource IntToStringConverter}}"
       />

                <Label Text="Lien Google (facultatif)" />
                <Entry Text="{Binding CurrentUrl}" Placeholder="https://..." />

                <Label Text="Coût prévu (€)" />
                <Entry Text="{Binding CurrentTravelActivity.PlannedCost}" Keyboard="Numeric" Placeholder="0.00" />

                <!-- Activity Date -->
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Date Activité:" FontSize="Small" />
                    <DatePicker Date="{Binding CurrentTravelActivity.ActivityDate, Mode=TwoWay}" MinimumDate="{Binding MinDate}" MaximumDate="{Binding MaxDate}"></DatePicker>
                </VerticalStackLayout>
                <Picker    Title="Type d’activité"
                           ItemsSource="{Binding DataStore.ActivityType}"
                           SelectedItem="{Binding SelectedActivityType, Mode=TwoWay}"
                           ItemDisplayBinding="{Binding Name}" />


                <Button Text="{Binding ModeDisplay}"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Margin="0,20"
                    Command="{Binding SaveCommand }"  />



            </VerticalStackLayout>
            <WebView Grid.Column="1">
                <WebView.Source>
                    <UrlWebViewSource Url="{Binding CurrentUrl}" />
                </WebView.Source>
            </WebView>
        </Grid>

       
    </ScrollView>


</ContentPage>