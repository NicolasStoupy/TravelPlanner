<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Presentation.MAUI.Views.ImportExport"
             xmlns:views="clr-namespace:Presentation.MAUI.Views"
             xmlns:vm="clr-namespace:Presentation.MAUI.ViewModel"
               xmlns:conv="clr-namespace:Presentation.MAUI.Converters"
             xmlns:entities="clr-namespace:BussinessLogic.Entities;assembly=BussinessLogic"
             xmlns:bu="clr-namespace:BussinessLogic.Entities;assembly=BussinessLogic"
             xmlns:res="clr-namespace:Presentation.MAUI.Resources.Localization"
             x:DataType="vm:ImportExportVM">



    <!-- Converters -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"></conv:ByteArrayToImageConverter>
            <conv:StringLimitConverter x:Key="StringLimitConverter"></conv:StringLimitConverter>
        </ResourceDictionary>
    </ContentPage.Resources>
    <!-- Converters -->

    <Grid RowDefinitions="50,*" Margin="10">
        <Border StrokeThickness="1"
            StrokeShape="RoundRectangle 5"
            >
            <Grid ColumnDefinitions="70,*" Grid.Row="0">
                <Border Stroke="Transparent" Grid.Row="0" Grid.Column="1">
                    <Label TextColor="Black"  Text="{Binding EditorExplanation}">
                    </Label>
                </Border>
                <Border Stroke="Transparent" Grid.Row="0" Grid.Column="0" BackgroundColor="Transparent">
                    <FlexLayout Direction="Row">
                        <Button ImageSource="{StaticResource UploadIcon}"                            
                            TextColor="Black"
                            BackgroundColor="Transparent"
                            Command="{Binding ImportCommand}" />
                    </FlexLayout>
                </Border>
            </Grid>
        </Border>
        <ScrollView Grid.Row="1">
            <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Start"
                        Margin="10"
                        BindableLayout.ItemsSource="{Binding Travels}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="entities:Travel">
                        <Border WidthRequest="200"
                                HeightRequest="300"
                                Stroke="LightGray"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="White"
                                Margin="8"
                                Padding="10">
                            <Grid RowDefinitions="Auto,30,30">
                                <VerticalStackLayout Grid.Row="0" Spacing="5">
                                    <Image Source="{Binding image, Converter={StaticResource ByteArrayToImageConverter}}"
                                           HeightRequest="150"
                                           Aspect="AspectFill" />
                                    <Label Text="{Binding name}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding description, Converter={StaticResource StringLimitConverter}, ConverterParameter='40|[...]'}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                    <Label Text="{Binding travelDate}" 
                                           FontSize="12"
                                           TextColor="DarkGray" />
                                    <Label FontSize="11" TextColor="Gray">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Du " />
                                                <Span Text="{Binding StartDate.Date.Day}" />
                                                <Span Text=" au " />
                                                <Span Text="{Binding EndDate, StringFormat='{}{0:dd/MM/yyyy}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>

                                <FlexLayout Grid.Row="1"
                                    Direction="Row"
                                    Wrap="Wrap"                                                
                                    JustifyContent="SpaceEvenly"
                                    AlignItems="Start"
                                    Padding="0"                                                
                                    Margin="0">
                                    <Button ImageSource="{StaticResource ExportIcon}"
                                   
                                            Text="Exporter"
                                            TextColor="Black"
                                    BackgroundColor="Transparent"
                                    Command="{Binding BindingContext.ExportCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}">
                                    </Button>
                                </FlexLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>

    </Grid>

</ContentPage>